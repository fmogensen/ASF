#!/usr/bin/env bash
# Installed via `git config core.hooksPath .githooks`. Runs the test suite and the
# generic-repo check before every commit; both must be clean.
set -euo pipefail

# A test's own commit, inside a checkout this hook is also active for, would otherwise run the
# suite again from within the suite: the marker makes the nested hook return at once (B-0073).
if [ -n "${ASF_HOOK_RUNNING:-}" ]; then
    exit 0
fi
export ASF_HOOK_RUNNING=1

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# A hook inherits GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE; a test that runs git in a temporary
# repository would then operate on this one instead.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

echo "pre-commit: running tests..."
python3 -m unittest discover -s tests

echo "pre-commit: checking for forbidden names..."
bash tools/check_generic.sh
