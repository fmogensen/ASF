#!/usr/bin/env bash
# Installed via `git config core.hooksPath .githooks`. Runs the generic-repo
# check and the redaction gate before every commit; both must be clean (the suite: see below).
set -euo pipefail

# A test's own commit, inside a checkout this hook is also active for, would otherwise run the
# suite again from within the suite: the marker makes the nested hook return at once (B-0073).
if [ -n "${ASF_HOOK_RUNNING:-}" ]; then
    exit 0
fi
export ASF_HOOK_RUNNING=1

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# A hook inherits GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE; a test that runs git in a temporary
# repository would then operate on this one instead.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# The suite is not run here: every worker commit ran it serially (324 s, one core each) and
# four sessions at once held every product's wave on host pressure. The harvest gate
# (conventions.test_command) and remote CI (.github/workflows/tests.yml) run it before a
# change lands; ASF_PRECOMMIT_SUITE=1 runs it here too.
if [ -n "${ASF_PRECOMMIT_SUITE:-}" ]; then
    echo "pre-commit: running tests..."
    python3 tools/run_tests.py
fi

echo "pre-commit: checking for forbidden names..."
bash tools/check_generic.sh

echo "pre-commit: checking staged lines for names and secrets..."
python3 -m asf.redact --pre-commit
