__pycache__/
*.pyc
.pytest_cache/

# generated by any build (pipx install, pip install -e): tracking it means every build
# dirties the checkout, and harvest then refuses to fast-forward it
*.egg-info/

# a session's own scratch files in a card's worktree (a gate log, a throwaway script): untracked
# by convention, but the factory's own wip auto-commit (commit_leftovers, B-0094) runs `git add
# -A` and has swept these into a branch's history more than once (B-0110, B-0119)
.b[0-9][0-9][0-9][0-9]_*
